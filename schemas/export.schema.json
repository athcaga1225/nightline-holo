{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NIGHTLINE 聊天紀錄匯出檔",
  "type": "object",
  "required": [
    "format",
    "version",
    "contacts"
  ],
  "properties": {
    "format": {
      "const": "nightline-holo-chat"
    },
    "version": {
      "const": 1
    },
    "exportedAt": {
      "type": "string"
    },
    "active": {
      "type": "string"
    },
    "contacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "settings": {
            "type": "object"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "message.schema.json"
            }
          }
        }
      }
    }
  }
}